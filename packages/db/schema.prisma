generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Money is always integer paise. Percentages are basis points (1800 = 18%).

// ───────── Identity ─────────
model User {
  id            String         @id @default(cuid())
  phone         String?        @unique // E.164
  phoneVerified Boolean        @default(false)
  email         String?        @unique
  emailVerified Boolean        @default(false)
  name          String?
  isBlocked     Boolean        @default(false)
  addresses     Address[]
  orders        Order[]
  carts         Cart[]
  reviews       Review[]
  wishlist      WishlistItem[]
  consents      ConsentLog[]
  sessions      Session[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String // ISO 3166-2:IN suffix, e.g. "DL"
  pincode   String  @db.Char(6)
  isDefault Boolean @default(false)

  @@index([userId])
}

// DPDP Act evidence of consent
model ConsentLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  anonId      String?
  purpose     String // marketing_sms, analytics, ...
  granted     Boolean
  textVersion String
  ip          String?
  createdAt   DateTime @default(now())

  @@index([userId])
}

model OtpChallenge {
  id         String    @id @default(cuid())
  target     String // phone or email
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([target, createdAt])
}

// Refresh-token rotation; exactly one of userId / staffId is set
model Session {
  id        String     @id @default(cuid())
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffId   String?
  staff     StaffUser? @relation(fields: [staffId], references: [id], onDelete: Cascade)
  tokenHash String     @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime   @default(now())

  @@index([userId])
  @@index([staffId])
}

// ───────── Staff / RBAC ─────────
model StaffUser {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  totpSecret   String? // AES-GCM encrypted
  totpEnabled  Boolean    @default(false)
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  isActive     Boolean    @default(true)
  lastLoginAt  DateTime?
  sessions     Session[]
  auditLogs    AuditLog[]
  createdAt    DateTime   @default(now())
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  permissions RolePermission[]
  staff       StaffUser[]
}

model RolePermission {
  roleId     String
  permission String // "product:write"
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
}

model AuditLog {
  id         String     @id @default(cuid())
  staffId    String?
  staff      StaffUser? @relation(fields: [staffId], references: [id])
  action     String // "product.update"
  entityType String
  entityId   String
  diff       Json?
  ip         String?
  createdAt  DateTime   @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ───────── Catalog ─────────
model Category {
  id          String                @id @default(cuid())
  parentId    String?
  parent      Category?             @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[]            @relation("CategoryTree")
  slug        String                @unique
  path        String                @unique // materialised, e.g. "bottles/vacuum"
  name        String
  description String?
  imageUrl    String?
  position    Int                   @default(0)
  isActive    Boolean               @default(true)
  seoTitle    String?
  seoDesc     String?
  attributes  AttributeDefinition[]
  products    Product[]

  @@index([parentId])
}

enum AttrType {
  TEXT
  NUMBER
  ENUM
  BOOLEAN
}

// Per-category attribute schema: a new category needs rows here, not code.
model AttributeDefinition {
  id           String   @id @default(cuid())
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  key          String // "thermal_retention"
  label        String // "Thermal Performance"
  type         AttrType
  unit         String?
  enumValues   String[]
  isFilterable Boolean  @default(false)
  showInSpecs  Boolean  @default(true)
  isRequired   Boolean  @default(false)
  position     Int      @default(0)

  @@unique([categoryId, key])
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  products Product[]
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id                        String                   @id @default(cuid())
  slug                      String                   @unique
  title                     String
  tagline                   String?
  descriptionHtml           String // sanitised server-side on save
  status                    ProductStatus            @default(DRAFT)
  publishAt                 DateTime?
  categoryId                String
  category                  Category                 @relation(fields: [categoryId], references: [id])
  brandId                   String?
  brand                     Brand?                   @relation(fields: [brandId], references: [id])
  hsnCode                   String
  gstRateBp                 Int
  attributes                Json                     @default("{}") // validated against AttributeDefinition
  badges                    String[]
  personalizationEnabled    Boolean                  @default(false)
  personalizationPricePaise Int?
  warrantyMonths            Int?
  ratingAvg                 Decimal                  @default(0) @db.Decimal(3, 2)
  ratingCount               Int                      @default(0)
  seoTitle                  String?
  seoDesc                   String?
  searchVector              Unsupported("tsvector")?
  options                   ProductOption[]
  variants                  Variant[]
  media                     ProductMedia[]
  reviews                   Review[]
  wishlisted                WishlistItem[]
  relationsFrom             ProductRelation[]        @relation("RelFrom")
  relationsTo               ProductRelation[]        @relation("RelTo")
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  deletedAt                 DateTime?

  @@index([categoryId, status])
}

model ProductOption {
  id        String        @id @default(cuid())
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String // "Capacity", "Color", "Lid"
  position  Int
  displayAs String        @default("PILL") // PILL | SWATCH | DROPDOWN
  values    OptionValue[]

  @@unique([productId, name])
}

model OptionValue {
  id         String               @id @default(cuid())
  optionId   String
  option     ProductOption        @relation(fields: [optionId], references: [id], onDelete: Cascade)
  value      String // "550 ml", "Pink"
  position   Int
  hexColor   String?
  textureUrl String?
  variants   VariantOptionValue[]
  media      ProductMedia[]

  @@unique([optionId, value])
}

model Variant {
  id             String                   @id @default(cuid())
  productId      String
  product        Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String                   @unique
  barcode        String?
  pricePaise     Int // selling price, tax-inclusive
  mrpPaise       Int
  weightGrams    Int
  lengthMm       Int?
  widthMm        Int?
  heightMm       Int?
  position       Int                      @default(0)
  isActive       Boolean                  @default(true)
  options        VariantOptionValue[]
  inventory      InventoryLevel[]
  movements      StockMovement[]
  reservations   StockReservation[]
  alerts         StockAlertSubscription[]
  media          ProductMedia[]
  cartItems      CartItem[]
  milestoneGifts CartMilestone[]

  @@index([productId])
}

model VariantOptionValue {
  variantId     String
  variant       Variant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValueId String
  optionValue   OptionValue @relation(fields: [optionValueId], references: [id])

  @@id([variantId, optionValueId])
}

model ProductMedia {
  id            String       @id @default(cuid())
  productId     String
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId     String? // pin to one variant
  variant       Variant?     @relation(fields: [variantId], references: [id])
  optionValueId String? // or to a colour (all variants of it)
  optionValue   OptionValue? @relation(fields: [optionValueId], references: [id])
  url           String
  alt           String // required for accessibility
  width         Int
  height        Int
  kind          String       @default("IMAGE") // IMAGE | VIDEO
  position      Int

  @@index([productId, position])
}

// cross-sell, upsell, spare parts
model ProductRelation {
  fromId   String
  from     Product @relation("RelFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId     String
  to       Product @relation("RelTo", fields: [toId], references: [id], onDelete: Cascade)
  type     String // CROSS_SELL | UPSELL | SPARE_PART
  position Int     @default(0)

  @@id([fromId, toId, type])
}

// ───────── Inventory ─────────
model Warehouse {
  id           String             @id @default(cuid())
  name         String
  code         String             @unique
  pincode      String             @db.Char(6)
  state        String
  isActive     Boolean            @default(true)
  levels       InventoryLevel[]
  movements    StockMovement[]
  reservations StockReservation[]
  shipments    Shipment[]
}

// CHECK (on_hand >= 0 AND reserved >= 0 AND reserved <= on_hand) added in raw SQL migration
model InventoryLevel {
  variantId   String
  variant     Variant   @relation(fields: [variantId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  onHand      Int       @default(0)
  reserved    Int       @default(0)
  lowStockAt  Int       @default(5)
  version     Int       @default(0)

  @@id([variantId, warehouseId])
}

// append-only ledger
model StockMovement {
  id          String    @id @default(cuid())
  variantId   String
  variant     Variant   @relation(fields: [variantId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  delta       Int
  reason      String // PURCHASE | SALE | RETURN | ADJUST | DAMAGE
  refType     String?
  refId       String?
  staffId     String?
  createdAt   DateTime  @default(now())

  @@index([variantId, createdAt])
}

// TTL hold during checkout
model StockReservation {
  id          String    @id @default(cuid())
  variantId   String
  variant     Variant   @relation(fields: [variantId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  qty         Int
  cartId      String?
  orderId     String?
  expiresAt   DateTime
  releasedAt  DateTime?

  @@index([expiresAt])
  @@index([orderId])
}

// "Notify me when available"
model StockAlertSubscription {
  id         String    @id @default(cuid())
  variantId  String
  variant    Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  contact    String
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([variantId, contact])
}

// ───────── Promotions ─────────
enum CouponType {
  PERCENT
  FLAT
  FREE_SHIPPING
}

model Coupon {
  id               String             @id @default(cuid())
  code             String             @unique
  type             CouponType
  valueBp          Int? // PERCENT
  valuePaise       Int? // FLAT
  maxDiscountPaise Int?
  minSubtotalPaise Int                @default(0)
  usageLimit       Int?
  perUserLimit     Int?
  usedCount        Int                @default(0)
  appliesTo        Json? // {categoryIds:[], productIds:[]}
  stackable        Boolean            @default(false)
  autoApply        Boolean            @default(false)
  paymentMethods   String[] // e.g. ["UPI"]
  startsAt         DateTime
  endsAt           DateTime?
  isActive         Boolean            @default(true)
  redemptions      CouponRedemption[]
}

model CouponRedemption {
  id          String   @id @default(cuid())
  couponId    String
  coupon      Coupon   @relation(fields: [couponId], references: [id])
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  userId      String?
  phone       String?
  amountPaise Int
  createdAt   DateTime @default(now())

  @@unique([couponId, orderId])
}

enum RewardType {
  FREE_SHIPPING
  FREE_GIFT
  COIN_DRAW
  DISCOUNT
}

// admin-editable gamified tiers
model CartMilestone {
  id             String     @id @default(cuid())
  thresholdPaise Int
  rewardType     RewardType
  label          String
  giftVariantId  String?
  giftVariant    Variant?   @relation(fields: [giftVariantId], references: [id])
  valuePaise     Int?
  position       Int
  isActive       Boolean    @default(true)
}

// ───────── Cart ─────────
model Cart {
  id         String     @id @default(cuid())
  userId     String?
  user       User?      @relation(fields: [userId], references: [id])
  anonToken  String?    @unique
  couponCode String?
  pincode    String?    @db.Char(6)
  items      CartItem[]
  expiresAt  DateTime
  updatedAt  DateTime   @updatedAt

  @@index([userId])
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])
  qty       Int
  engraving String  @default("") // personalisation text, max 15; "" = none (keeps unique key null-safe)
  isGift    Boolean @default(false)

  @@unique([cartId, variantId, engraving, isGift])
}

// ───────── Orders ─────────
enum OrderStatus {
  PENDING_PAYMENT
  PLACED
  CONFIRMED
  PROCESSING
  PARTIALLY_SHIPPED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  CLOSED
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  WALLET
  COD
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  COD_PENDING
  COD_COLLECTED
}

model Order {
  id              String             @id @default(cuid())
  orderNumber     String             @unique // from order_seq, e.g. ML-100245
  publicId        String             @unique // unguessable, for guest links
  userId          String?
  user            User?              @relation(fields: [userId], references: [id])
  status          OrderStatus
  email           String?
  phone           String
  shippingAddress Json // snapshot
  billingAddress  Json // snapshot
  gstin           String?
  subtotalPaise   Int
  discountPaise   Int
  shippingPaise   Int
  codFeePaise     Int                @default(0)
  taxPaise        Int // informational (prices are tax-inclusive)
  totalPaise      Int
  currency        String             @default("INR")
  paymentMethod   PaymentMethod
  couponCodes     String[]
  idempotencyKey  String             @unique
  utm             Json?
  notes           String?
  cancelReason    String?
  invoiceNumber   String?            @unique
  placedAt        DateTime?
  items           OrderItem[]
  payments        Payment[]
  shipments       Shipment[]
  returns         ReturnRequest[]
  events          OrderEvent[]
  redemptions     CouponRedemption[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([userId])
  @@index([phone])
  @@index([status, createdAt])
}

// Snapshot of catalog data at purchase time
model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId      String?
  sku            String
  title          String
  variantTitle   String
  imageUrl       String
  hsnCode        String
  gstRateBp      Int
  unitPricePaise Int
  mrpPaise       Int
  qty            Int
  discountPaise  Int     @default(0)
  taxPaise       Int
  totalPaise     Int
  engraving      String?
  isGift         Boolean @default(false)
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String
  message   String?
  actor     String?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id])
  provider          String        @default("razorpay")
  providerOrderId   String?       @unique
  providerPaymentId String?       @unique
  method            PaymentMethod
  status            PaymentStatus
  amountPaise       Int
  failureCode       String?
  raw               Json?
  refunds           Refund[]
  createdAt         DateTime      @default(now())

  @@index([orderId])
}

model Refund {
  id               String   @id @default(cuid())
  paymentId        String
  payment          Payment  @relation(fields: [paymentId], references: [id])
  providerRefundId String?  @unique
  amountPaise      Int
  reason           String
  status           String
  staffId          String?
  createdAt        DateTime @default(now())
}

// idempotency + replay for provider webhooks
model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  type        String
  payload     Json
  processedAt DateTime?
  error       String?
  receivedAt  DateTime  @default(now())

  @@unique([provider, eventId])
}

// ───────── Fulfilment & Returns ─────────
model Shipment {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id])
  warehouseId String
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id])
  courier     String?
  awb         String?         @unique
  labelUrl    String?
  status      String // CREATED | PICKED_UP | IN_TRANSIT | OFD | DELIVERED | RTO
  trackingUrl String?
  items       Json // [{orderItemId, qty}]
  shippedAt   DateTime?
  deliveredAt DateTime?
  events      ShipmentEvent[]

  @@index([orderId])
}

model ShipmentEvent {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     String
  location   String?
  at         DateTime

  @@index([shipmentId, at])
}

model ServiceablePincode {
  pincode    String   @id @db.Char(6)
  city       String
  state      String
  codAllowed Boolean
  etaDaysMin Int
  etaDaysMax Int
  updatedAt  DateTime @updatedAt
}

model ReturnRequest {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  type        String // RETURN | EXCHANGE | WARRANTY
  reason      String
  status      String // REQUESTED | APPROVED | PICKUP_SCHEDULED | RECEIVED | REFUNDED | REJECTED
  items       Json
  photos      String[]
  refundPaise Int?
  createdAt   DateTime @default(now())

  @@index([orderId])
}

// ───────── Engagement / Content ─────────
model Review {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  orderItemId String?
  rating      Int // 1..5, CHECK in raw SQL
  title       String?
  body        String
  photos      String[]
  status      String   @default("PENDING") // PENDING | APPROVED | HIDDEN
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([productId, status])
}

model WishlistItem {
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

model Page {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  blocks      Json
  seoTitle    String?
  seoDesc     String?
  isPublished Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

model Banner {
  id       String    @id @default(cuid())
  slot     String
  imageUrl String
  link     String?
  position Int
  startsAt DateTime?
  endsAt   DateTime?
  isActive Boolean   @default(true)
}

model Redirect {
  from String @id
  to   String
  code Int    @default(301)
}

model BulkEnquiry {
  id        String   @id @default(cuid())
  name      String
  company   String?
  phone     String
  email     String?
  qty       Int?
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
