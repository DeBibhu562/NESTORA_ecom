{
  "name": "@app/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "prisma": {
    "schema": "schema.prisma",
    "seed": "tsx --env-file=../../.env seed/seed.ts"
  },
  "scripts": {
    "migrate": "dotenv run -f ../../.env -- prisma migrate deploy",
    "migrate:dev": "dotenv run -f ../../.env -- prisma migrate dev",
    "generate": "prisma generate",
    "seed": "tsx --env-file=../../.env seed/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "dotenv": "^18.0.9",
    "dotenv-cli": "^7.4.0",
    "prisma": "^6.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
