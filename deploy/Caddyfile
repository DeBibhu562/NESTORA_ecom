# Storefront on :80, admin on :8081. Each site serves its own /v1 and /uploads from the API, so the browser never makes a cross-origin call.
:80 {
	encode gzip
	handle /v1/* {
		reverse_proxy api:4010
	}
	handle /uploads/* {
		reverse_proxy api:4010
	}
	handle {
		reverse_proxy web:3020
	}
}

:8081 {
	encode gzip
	handle /v1/* {
		reverse_proxy api:4010
	}
	handle /uploads/* {
		reverse_proxy api:4010
	}
	handle {
		reverse_proxy admin:3001
	}
}
