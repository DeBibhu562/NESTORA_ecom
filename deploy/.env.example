# Copy to .env on the server and fill in. Never commit the real file.
# Host ports Caddy listens on. PUBLIC_URL / ADMIN_URL must include them when they are not 80 / 8081.
WEB_PORT=80
ADMIN_PORT=8081
PUBLIC_URL=http://129.121.98.177
ADMIN_URL=http://129.121.98.177:8081
BRAND_NAME=Livoware

POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string-of-48+chars

# Plain http on a bare IP needs this; remove it (or set true) once you serve HTTPS on a domain.
COOKIE_SECURE=false

# First-run owner account (used by the seed command)
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=change-me-strong-password

# Optional integrations, see the root .env.example for details
SMTP_URL=
MAIL_FROM=Livoware <no-reply@livoware.store>
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
FIREBASE_PROJECT_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP=Primary
SHIPROCKET_WEBHOOK_TOKEN=
