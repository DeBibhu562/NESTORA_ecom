DATABASE_URL=postgresql://app:app@localhost:5442/ecommerce
REDIS_URL=redis://localhost:6390
SMTP_URL=smtp://localhost:1025
JWT_SECRET=change-me-32-chars-minimum-please!!
NEXT_PUBLIC_BRAND_NAME=Nestora
NEXT_PUBLIC_API_URL=http://localhost:4010/v1
PORT=4010
NEXT_PUBLIC_SITE_URL=http://localhost:3020
STOCK_ALERT_LIMIT_PER_HOUR=1000 # dev/e2e only; the production default is 10 per IP per hour
# Razorpay (optional; without these the store is COD-only). Webhook URL: <api>/v1/webhooks/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Customer login. Email codes use SMTP (Gmail: smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465); SMTP_URL is set above.
MAIL_FROM="Nestora <you@gmail.com>"
# Google sign-in via Firebase Auth (console → Authentication → enable Google; add your domain under Authorized domains)
FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# WhatsApp Cloud API (optional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Shiprocket (optional; without it staff enter courier + AWB by hand)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP=Primary
SHIPROCKET_WEBHOOK_TOKEN=
